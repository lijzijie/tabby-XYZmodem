{
  "name": "tabby-xyzmodem",
  "version": "1.1.1",
  "description": "XMODEM, YMODEM and ZMODEM file transfer plugin for Tabby terminal",
  "keywords": [
    "tabby-plugin",
    "xmodem",
    "ymodem",
    "zmodem",
    "serial",
    "firmware",
    "file-transfer"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "homepage": "https://github.com/lijzijie/tabby-XYZmodem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijzijie/tabby-XYZmodem.git"
  },
  "bugs": {
    "url": "https://github.com/lijzijie/tabby-XYZmodem/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/protocol.test.js",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE"
  ],
  "author": "ziggylin",
  "license": "MIT",
  "devDependencies": {
    "@angular/cdk": "^12.2.13",
    "@angular/animations": "^12.0.0",
    "@angular/common": "^12.0.0",
    "@angular/core": "^12.0.0",
    "@angular/forms": "^12.0.0",
    "@angular/platform-browser": "^12.0.0",
    "@ng-bootstrap/ng-bootstrap": "^2.2.0",
    "@types/webpack-env": "^1.16.0",
    "apply-loader": "^2.0.0",
    "css-loader": "^5.1.1",
    "pug": "^2.0.3",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.3.0",
    "sass": "^1.60.0",
    "sass-loader": "^11.0.1",
    "style-loader": "^2.0.0",
    "tabby-core": "^1.0.156",
    "tabby-settings": "^1.0.156",
    "tabby-terminal": "^1.0.156",
    "ts-loader": "^9.5.4",
    "typescript": "~4.9.5",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0"
  },
  "dependencies": {
    "xmodem.js": "^0.1.0",
    "ymodem.js": "^0.0.1-1",
    "zmodem.js": "^0.1.10"
  }
}
